# @wordpress/theme 2.0 declares an optional peer on vite ^7 || ^8, and this
# project builds on vite 5. The peer is optional — the theme package only needs
# it for a Vite integration we don't use, and the design tokens it ships (the
# only thing imported here, in src/main.tsx) are plain CSS. Strict peer
# resolution still fails the install on a clean checkout, so accept the tree
# this repo has always been developed against rather than force a vite major.
legacy-peer-deps=true
